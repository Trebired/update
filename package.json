{
  "name": "@trebired/update",
  "version": "1.0.13",
  "description": "Generic update runtime for distributed binaries and packages, with high-level flows, rollout orchestration primitives, persistence helpers, and safe activation.",
  "type": "module",
  "private": false,
  "license": "MIT",
  "author": "Miroslav Machynka (Trebired)",
  "config": {
    "organization": {
      "name": "trebired"
    }
  },
  "packageManager": "bun@1.3.12",
  "engines": {
    "bun": ">=1.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    ".trebired/logger/config.ts",
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "bun run prepare:generated && rm -rf dist && tsc -p tsconfig.build.json && bun ./scripts/prepare-dist.mjs prepare-dist",
    "postpack": "bun ./scripts/prepare-dist.mjs postpack",
    "prepack": "bun run build && bun ./scripts/prepare-dist.mjs prepack",
    "prepublishOnly": "bun run typecheck && bun run verify:pack",
    "prepare:generated": "bun ./scripts/build/generated/tsconfig.mjs",
    "typecheck": "bun run prepare:generated && tsc --noEmit",
    "verify:pack": "bun ./scripts/verify-pack.mjs"
  },
  "dependencies": {
    "@package/logger-adapter": "npm:@trebired/logger-adapter@^0.4.6",
    "@package/result": "npm:@trebired/result@^1.1.6",
    "fflate": "^0.8.3",
    "semver": "^7.8.5",
    "tar-stream": "^3.2.0"
  },
  "devDependencies": {
    "@trebired/code-discipline": "^6.0.11",
    "@trebired/code-discipline-config": "^0.1.3",
    "@types/bun": "^1.3.14",
    "@types/node": "^24.13.3",
    "@types/semver": "^7.8.0",
    "@types/tar-stream": "^3.1.4",
    "typescript": "^6.0.3"
  },
  "keywords": [
    "update",
    "updater",
    "distributed-systems",
    "binary-updates",
    "orchestration",
    "scheduler",
    "rollout",
    "resumable-downloads",
    "persistence",
    "package-updates",
    "rollback",
    "ed25519",
    "bun"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Trebired/update"
  },
  "homepage": "https://github.com/Trebired/update#readme",
  "bugs": {
    "url": "https://github.com/Trebired/update/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
